# Copy to .env and adjust for your deployment.
# Required in production — must be a long, random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Network
PORT=8080
HOST=0.0.0.0

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*

# Where the SQLite database lives.
DB_FILE=ping.db

# bcrypt cost factor (higher = slower = safer).
BCRYPT_ROUNDS=10
