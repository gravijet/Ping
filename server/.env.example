# Copy to .env and adjust for your deployment.
# Required in production — must be a long, random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Network. 61337 is in the private port range and above the usual Linux
# ephemeral range, so it won't clash with other services on a shared host.
PORT=61337
HOST=0.0.0.0

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*

# Where the SQLite database lives. Avatars are stored in <dir>/uploads next to
# it (override with UPLOADS_DIR).
DB_FILE=ping.db
# UPLOADS_DIR=/data/uploads

# bcrypt cost factor (higher = slower = safer) for the optional backup password.
BCRYPT_ROUNDS=10

# Phone login. Numbers typed without a country code default to this one
# (49 = Germany). Users can always type +<cc> to override.
DEFAULT_COUNTRY_CODE=49

# One-time login codes. We ship without an SMS gateway, so by default the code
# is returned in the API response (and logged) to make the flow work out of the
# box. Set this to false once you put a real SMS provider in front of it.
OTP_RETURN_IN_RESPONSE=true
# OTP_TTL_MS=600000
# OTP_MAX_ATTEMPTS=5

# Max profile-picture upload size in bytes (default 5 MiB).
# MAX_AVATAR_BYTES=5242880
