# Copy to .env and adjust for your deployment. `npm start` loads this file
# automatically (node --env-file-if-exists=.env). Never commit your real .env.

# Production mode. Enforces a strong JWT_SECRET and a set ADMIN_TOKEN (no
# insecure dev fallbacks). Leave unset for local hacking.
NODE_ENV=production

# Required in production — must be a long, random string (>=16 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Network. 61337 is in the private port range and above the usual Linux
# ephemeral range, so it won't clash with other services on a shared host.
PORT=61337
HOST=0.0.0.0

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*

# Where the SQLite database lives. Avatars are stored in <dir>/uploads next to
# it (override with UPLOADS_DIR).
DB_FILE=ping.db
# UPLOADS_DIR=/data/uploads

# bcrypt cost factor (higher = slower = safer) for password hashing.
BCRYPT_ROUNDS=10

# Phone numbers typed without a country code default to this one
# (49 = Germany). Users can always type +<cc> to override.
DEFAULT_COUNTRY_CODE=49

# Max profile-picture upload size in bytes (default 5 MiB).
# MAX_AVATAR_BYTES=5242880

# Privacy: max number of phone/email identifiers a single contact-match
# request may carry. Contacts are matched in memory and never stored.
# MAX_CONTACT_MATCH=2000

# Admin portal. This token unlocks /admin and the /api/admin/* endpoints.
# REQUIRED in production — without it the admin portal stays disabled (503).
# In development it defaults to "ping-admin-dev" so the portal works out of the
# box. Use a long, random value in production.
ADMIN_TOKEN=change-me-to-a-long-random-admin-token

# Hide the admin portal behind a non-guessable path (default /admin). Set this
# in production so the dashboard isn't at the obvious URL. The /api/admin/*
# endpoints stay where they are; only the portal HTML page moves.
# ADMIN_PATH=/control-7f3a9c

# Cloudflare Zero Trust (Access). When this deployment sits behind a Cloudflare
# Access application protecting the admin portal + /api/admin, set both values
# to make the origin verify the Access JWT (header Cf-Access-Jwt-Assertion).
# Then even a request that bypasses Cloudflare (direct to the origin IP) can't
# reach admin. Leave unset to disable. Get the AUD from the Access app's config.
#   CF_ACCESS_TEAM_DOMAIN – your team domain, e.g. myteam.cloudflareaccess.com
#   CF_ACCESS_AUD         – the Access application Audience (AUD) tag
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-aud-tag

# Requests allowed per 15-min window on the auth + admin endpoints (per IP).
# AUTH_RATE_MAX=40
# Requests allowed per minute on the general API (per IP).
# API_RATE_MAX=300

# ---- Phone verification by SMS (server-side OTP) --------------------------
# Ping can verify phone numbers itself by texting a one-time code (no Firebase
# console setup needed). Pick how codes are delivered:
#   log    – (default) NO real SMS. The code is printed to the server log and
#            returned in the API response so you can test the whole flow for free.
#   twilio – Twilio REST API (needs SMS_TWILIO_SID, SMS_TWILIO_TOKEN, SMS_FROM).
#   http   – any HTTP SMS gateway: POSTs {"to","text","from"} as JSON to SMS_HTTP_URL.
# SMS_PROVIDER=log
# SMS_FROM=Ping
# SMS_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_TWILIO_TOKEN=your-twilio-auth-token
# SMS_HTTP_URL=https://sms-gateway.example.com/send
# SMS_HTTP_AUTH=Bearer your-gateway-token
# Return the code in the API response (default on for the 'log' provider only).
# SMS_EXPOSE_CODE=0
# One-time-code shape + lifetime.
# OTP_LENGTH=6
# OTP_TTL_MS=300000
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_MS=30000

# ---- App download (landing page + APK) ------------------------------------
# Visiting the root domain serves a landing page that auto-downloads the newest
# APK found here. Publish a build with server/scripts/publish-apk.sh.
# APK_DIR=/data/downloads
# Primary domain of this deployment.
# PUBLIC_URL=https://example.invalid
# Windows desktop installer — hosted locally, like the APK. Drop the .exe (e.g.
# Ping-Setup-0.13.0.exe) into the downloads folder (defaults to the same one as
# the APK) and the landing page shows a "Für Windows" card; /download/windows
# and /download/windows.exe stream it. The .exe can't be built on a Linux host,
# so build it on a Windows PC (or CI) and just copy it in.
# WINDOWS_DIR=/data/downloads
# Overrides the version label (otherwise parsed from the .exe filename).
# WINDOWS_VERSION=0.13.0
# Optional fallback: if no local .exe exists, redirect /download/windows here.
# WINDOWS_DOWNLOAD_URL=

# ---- Firebase phone verification (legacy / optional) ----------------------
# The Firebase project whose phone-auth ID tokens count as proof of ownership.
# Still accepted by /auth/register, but the server-side SMS OTP above is the
# primary path now.
# FIREBASE_PROJECT_ID=ping-gj
# Set to 1 to require a verified phone token on /auth/register (keep off until
# the verifying app build is rolled out to everyone).
# REQUIRE_PHONE_VERIFICATION=0

# ---- Firebase Cloud Messaging (push notifications) ------------------------
# Path to the Firebase service-account JSON (Firebase console → Project
# settings → Service accounts → "Generate new private key"). When present the
# server sends FCM push notifications for new messages and admin broadcasts to
# devices that don't currently have the app open. Without it push stays off and
# everything else keeps working over the live WebSocket.
# Default: <server>/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT=/data/firebase-service-account.json

# ---- WebRTC calls (TURN/STUN) ---------------------------------------------
# Calls need a TURN server (coturn) to relay media through NAT — see
# server/deploy/coturn.md. /api/ice serves these to the app.
# STUN_URL=stun:example.invalid:3478
# TURN_URL=turn:example.invalid:3478
# TURN_USER=pingturn
# TURN_PASS=your-long-random-secret
